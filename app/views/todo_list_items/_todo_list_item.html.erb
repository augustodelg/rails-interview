<div class="flex  space-x-3 p-3 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors" id="<%= dom_id(todo_list_item) %>">
  <%= button_to toggle_todo_list_todo_list_item_path(todo_list_item.todo_list, todo_list_item), 
        method: :patch,
        class: "flex-shrink-0 align-middle #{todo_list_item.is_done? ? 'text-green-600' : 'text-gray-400'} hover:#{todo_list_item.is_done? ? 'text-green-900' : 'text-gray-500'}" do %>
    <% if todo_list_item.is_done? %>
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
    <% else %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" stroke-width="2"/>
      </svg>
    <% end %>
  <% end %>

  <!-- Item Description -->
  <div class="flex-1">
    <span class="<%= 'line-through text-gray-500' if todo_list_item.is_done %> <%= 'text-gray-900' unless todo_list_item.is_done %>">
      <%= todo_list_item.description %>
    </span>
  </div>

  <!-- Status Badge -->
  <div class="flex-shrink-2 align-middle">
    <% if todo_list_item.is_done? %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
        ✓ Complete
      </span>
    <% else %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
        Pending
      </span>
    <% end %>
  </div>

  <!-- Delete Button -->
  <%= button_to todo_list_todo_list_item_path(todo_list_item.todo_list, todo_list_item), 
        method: :delete,
        data: { confirm: "Are you sure you want to delete this item?" },
        class: "flex-shrink-0 align-middle text-red-400 hover:text-red-600 ml-2" do %>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
    </svg>
  <% end %>
</div>