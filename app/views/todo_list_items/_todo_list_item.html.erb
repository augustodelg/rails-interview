<%= turbo_frame_tag todo_list_item do %>
  <div class="bg-white rounded-lg border p-4 flex items-center space-x-4 <%= 'opacity-75' if todo_list_item.completed? %>">
    <div class="flex-shrink-0">
      <%= button_to toggle_todo_list_todo_list_item_path(todo_list_item.todo_list, todo_list_item),
                   method: :patch,
                   data: { turbo_method: :patch },
                   class: "p-1 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
        <% if todo_list_item.completed? %>
          <div class="w-5 h-5 bg-green-500 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
        <% else %>
          <div class="w-5 h-5 border-2 border-gray-300 rounded-full hover:border-green-400"></div>
        <% end %>
      <% end %>
    </div>

    <div class="flex-1">
      <p class="text-gray-900 <%= 'line-through text-gray-500' if todo_list_item.completed? %>">
        <%= todo_list_item.description %>
      </p>
      <p class="text-xs text-gray-500 mt-1">
        Created <%= time_ago_in_words(todo_list_item.created_at) %> ago
        <% if todo_list_item.completed? %>
          • Completed
        <% end %>
      </p>
    </div>

    <div class="flex-shrink-0">
      <%= link_to "Delete", todo_list_todo_list_item_path(todo_list_item.todo_list, todo_list_item),
                 method: :delete,
                 data: { 
                   confirm: "Are you sure?",
                   turbo_method: :delete
                 },
                 class: "text-gray-400 hover:text-red-600 text-sm" %>
    </div>
  </div>
<% end %>