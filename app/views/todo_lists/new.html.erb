<div class="container">
  <h1>Create New Todo List</h1>
  
  <div class="form-container">
    <%= form_with model: @todo_list, local: true, class: "todo-form" do |form| %>
      <div class="form-group">
        <%= form.label :name, "Todo List Name", class: "form-label" %>
        <%= form.text_field :name, class: "form-input", placeholder: "Enter a name for your todo list..." %>
      </div>
      
      <div class="form-actions">
        <%= form.submit "Create Todo List", class: "btn btn-primary" %>
        <%= link_to "Cancel", todo_lists_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>