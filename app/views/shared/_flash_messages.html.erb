<% if notice %>
  <div class="mb-4 px-4 py-3 text-green-700 bg-green-100 border border-green-400 rounded" role="alert" data-turbo-temporary>
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="mb-4 px-4 py-3 text-red-700 bg-red-100 border border-red-400 rounded" role="alert" data-turbo-temporary>
    <%= alert %>
  </div>
<% end %>